{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "regions": ["sfo1"],
  "rewrites": [{ "source": "/((?!_site/|api/|robots\\.txt$).*)", "destination": "/api/page" }],
  "headers": [
    { "source": "/_site/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "functions": { "api/page.mjs": { "maxDuration": 10 } }
}
