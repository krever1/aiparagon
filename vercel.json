{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/voice-agent-client.html", "destination": "/voice/overview", "permanent": false },
    { "source": "/mhwp-dashboard.html", "destination": "/advisory/touchpoint", "permanent": false }
  ],
  "rewrites": [
    { "source": "/voice", "destination": "/voice-agent-client.html" },
    { "source": "/voice/:path*", "destination": "/voice-agent-client.html" },
    { "source": "/advisory", "destination": "/mhwp-dashboard.html" },
    { "source": "/advisory/:path*", "destination": "/mhwp-dashboard.html" }
  ]
}
